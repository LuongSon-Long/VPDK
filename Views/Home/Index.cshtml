@model List<HeThongQuanLyVanPhong.DTOs.TaiKhoan.ModuleDashboardDto>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Trang chủ hệ thống";
    var sessionTinhId = Context.Session.GetInt32("UserTinhId") ?? 0;
    var userId = Context.Session.GetInt32("UserId") ?? 0;
    var displayModules = Model != null
        ? new List<HeThongQuanLyVanPhong.DTOs.TaiKhoan.ModuleDashboardDto>(Model)
        : new List<HeThongQuanLyVanPhong.DTOs.TaiKhoan.ModuleDashboardDto>();
    if (userId == -1)
    {
        if (!displayModules.Any(m => m.Url != null && m.Url.Contains("/DoDac", StringComparison.OrdinalIgnoreCase)))
        {
            displayModules.Add(new HeThongQuanLyVanPhong.DTOs.TaiKhoan.ModuleDashboardDto
            {
                TenModule = "Đo đạc",
                Url = "/DoDac",
                IconClass = "bi-map-fill"
            });
        }
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .module-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 12px;
        cursor: pointer;
    }

        .module-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
            background-color: #f8f9fa;
        }

    .module-icon {
        font-size: 3rem;
        color: #0d6efd;
    }
</style>

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2 class="display-6 fw-bold">HỆ THỐNG VĂN PHÒNG ĐĂNG KÝ ĐẤT ĐAI</h2>
        <p class="text-muted">Bạn đã đăng nhập thành công!</p>
    </div>

    <div class="bg-white rounded-4 shadow-sm p-3 mb-4 border-start border-primary border-5 d-flex flex-column flex-md-row align-items-md-center justify-content-between">
        <div class="d-flex align-items-center mb-3 mb-md-0">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                <i class="bi bi-person-circle fs-3"></i>
            </div>
            <div>
                <h5 class="mb-1 fw-bold text-dark">@Context.Session.GetString("FullName")</h5>
                <div class="text-muted" style="font-size: 0.85rem;">
                    <span class="me-3"><i class="bi bi-person me-1"></i>@Context.Session.GetString("Username")</span>
                    <span class="me-3 d-none d-sm-inline">|</span>
                    <span class="me-3"><i class="bi bi-briefcase me-1"></i><span class="text-info fw-semibold">@Context.Session.GetString("ChucVu")</span></span>
                    <span class="me-3 d-none d-sm-inline">|</span>
                    <span><i class="bi bi-building me-1"></i>@Context.Session.GetString("DonViCongTac")</span>
                </div>
            </div>
        </div>

        <div class="text-md-end ms-md-3">
            <div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Tỉnh/Thành phố:</div>

            <select id="cboTenTinhHienThi" class="form-select form-select-sm bg-success bg-opacity-10 text-success border-success fw-bold rounded-pill shadow-sm" style="min-width: 220px; cursor: pointer;">
                <option value="0">Đang tải danh sách...</option>
            </select>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white rounded-top">
            <h5 class="mb-0"><i class="bi bi-grid-1x2-fill me-2"></i>Chức năng hệ thống</h5>
        </div>
        <div class="card-body">
            <div class="row text-center mt-3">
                @if (displayModules.Any())
                {
                    foreach (var module in displayModules)
                    {
                        <div class="col-6 col-md-4 col-lg-3 mb-4">
                            <a href="javascript:void(0);" data-url="@module.Url" class="text-decoration-none text-dark module-link">
                                <div class="card h-100 border bg-white shadow-sm module-card">
                                    <div class="card-body py-4">
                                        <i class="bi @module.IconClass module-icon"></i>
                                        <h6 class="mt-3 fw-bold">@module.TenModule</h6>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-4">
                        <p class="text-danger mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Tài khoản của bạn chưa được phân quyền sử dụng chức năng nào.
                        </p>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
<script>
    const SERVER_TINH_ID = parseInt('@sessionTinhId') || 0;

    $(document).ready(function () {
        const userTinhId = SERVER_TINH_ID;
        const $cboTenTinh = $('#cboTenTinhHienThi');

        $.ajax({
            url: '/api/dodac/dropdown/all-tinh',
            method: 'GET',
            success: function (res) {
                let opts = '<option value="0">-- Chọn đơn vị hành chính tỉnh --</option>';
                if (res && res.length > 0) {
                    res.forEach(t => {
                        const isSelected = (t.id === userTinhId) ? 'selected' : '';
                        opts += `<option value="${t.id}" ${isSelected}>${t.ten}</option>`;
                    });
                }
                $cboTenTinh.html(opts);
            },
            error: function () {
                $cboTenTinh.html('<option value="0">Lỗi tải danh sách tỉnh</option>');
            }
        });

        $cboTenTinh.on('change', function () {
            const selectedTinhId = parseInt($(this).val()) || 0;
            if (selectedTinhId > 0) {
                $(this).removeClass('border-danger border-2 text-danger shadow');
            }
        });

        $(document).on('click', '.module-link', function (e) {
            e.preventDefault();
            const url = $(this).data('url');
            const idTinhDuocChon = parseInt($cboTenTinh.val()) || 0;
            if (SERVER_TINH_ID === 0 && idTinhDuocChon === 0) {
                alert('Vui lòng lựa chọn "Đơn vị hành chính tỉnh" trước khi truy cập chức năng!');

                $cboTenTinh.focus().addClass('border-danger border-2 text-danger shadow');
                setTimeout(() => {
                    $cboTenTinh.removeClass('border-danger border-2 text-danger shadow');
                }, 2000);

                return false;
            }

            if (idTinhDuocChon > 0) {
                $(this).css('opacity', '0.5');

                $.ajax({
                    url: '/api/Auth/set-tinh',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ idTinh: idTinhDuocChon }),
                    success: function () {
                        window.location.href = url;
                    },
                    error: function (xhr, status, error) {
                        console.error("Lỗi đồng bộ Tỉnh:", error);
                        alert('Không thể lưu thông tin Tỉnh!');
                        $(this).css('opacity', '1');
                    }.bind(this)
                });
            } else {
                window.location.href = url;
            }
        });
    });
</script>