@* _PartialTiepNhan.cshtml - Hoàn toàn dùng API, đọc biến Global từ trang cha *@
<style>
    #tn_IDXa:disabled,
    #tn_IDTinh:disabled,
    input[readonly],
    select:disabled {
        border: 2px solid #dc3545 !important;
        opacity: 1 !important;
    }
    .is-filled {
        background-color: #e2e3e5 !important;
        color: #000 !important;
    }
</style>
<div class="card border-0 shadow-none">
    <div class="card-header bg-light py-2">
        <h6 class="mb-0 text-primary fw-bold">HỒ SƠ ĐO ĐẠC MỚI</h6>
    </div>
    <div class="card-body">
        <div class="row g-3">

            <div class="col-md-6">
                <label class="small fw-bold">Đăng ký tại đơn vị <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                    <select id="tn_selectDonVi" class="form-select">
                        <option value="">-- Vui lòng chọn đúng đơn vị xử lý --</option>
                    </select>
                    <div class="input-group-text d-none">
                        <input type="checkbox" id="tn_chkOtherUnit" class="form-check-input mt-0 me-1">
                        <span class="small">Đơn vị khác</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <label class="small fw-bold">Quy trình xử lý <span class="text-danger">*</span></label>
                <select id="tn_IDQuyTrinh" class="form-select form-select-sm">
                    <option value="">Đang tải quy trình...</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="small fw-bold">Số hợp đồng</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="tn_SoHopDong" class="form-control" placeholder="Nhấp nút lấy số..." />
                    <button id="btnLaySoHopDong" class="btn btn-outline-primary" type="button" onclick="tn_LaySoHopDong()">
                        <i class="bi bi-arrow-repeat"></i> Lấy số
                    </button>
                </div>
            </div>

            <div class="col-md-3">
                <label class="small fw-bold">Ngày đăng ký</label>
                <input type="text" id="tn_NgayHopDong" class="form-control form-control-sm" placeholder="dd/MM/yyyy" />
            </div>

            <div class="col-md-4">
                <label class="small fw-bold">Tổ chức, cá nhân đăng ký</label>
                <input type="text" id="tn_NguoiDangKy" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-4">
                <label class="small fw-bold">Số CC/CCCD/Mã số thuế</label>
                <input type="text" id="tn_CCCD" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="small fw-bold">Số điện thoại liên hệ</label>
                <input type="text" id="tn_SoDienThoai" class="form-control form-control-sm" />
            </div>

            <div class="col-md-6">
                <label class="small fw-bold">Địa chỉ thửa đất</label>
                <input type="text" id="tn_DiaChiThuaDat" class="form-control form-control-sm" />
            </div>

            <div class="col-md-3">
                <label class="small fw-bold">Xã/Phường</label>
                <select id="tn_IDXa" class="form-select form-select-sm">
                    <option value="">-- Chọn Xã --</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="small fw-bold">Tỉnh/Thành</label>
                <select id="tn_IDTinh" class="form-select form-select-sm">
                    <option value="">Đang tải tỉnh...</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="small fw-bold">Số phát hành GCN (nếu có)</label>
                <input type="text" id="tn_SeriGCN" class="form-control form-control-sm" />
            </div>
            <div class="col-md-8">
                <label class="small fw-bold">Mục đích đăng ký</label>
                <input type="text" id="tn_MucDich" class="form-control form-control-sm" placeholder="VD: Cấp đổi, chuyển nhượng, đăng ký kiểm tra..." />
            </div>

            <div class="col-md-12">
                <label class="small fw-bold">Ghi chú</label>
                <textarea id="tn_GhiChu" class="form-control form-control-sm" rows="2"></textarea>
            </div>
        </div>

        <div class="mt-3 text-end">
            <button type="button" class="btn btn-secondary btn-sm me-2" onclick="tn_Cancel()">
                Hủy bỏ
            </button>
            <button type="button" class="btn btn-primary btn-sm" onclick="tn_Submit()">
                <i class="bi bi-save"></i> LƯU ĐĂNG KÝ
            </button>
        </div>
    </div>
</div>

<script>
    // ============================================================
    // KHỞI TẠO PARTIAL TIẾP NHẬN
    // ============================================================
    var tn_DanhSachXa = [];
    async function tn_Init() {
        $('#tn_SoHopDong').on('input', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').addClass('is-valid');
            } else {
                $(this).removeClass('is-valid is-invalid');
            }
        });

        const now = new Date();
        const today = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()}`;
        $('#tn_NgayHopDong').val(today);

        // 1. KIỂM TRA VÀ KHÓA Ô SỐ HỢP ĐỒNG NẾU LÀ KHÁCH
        if (typeof SESSION_USER_ID !== 'undefined' && SESSION_USER_ID === -1) {
            $('#tn_SoHopDong')
                .prop('disabled', true)
                .val('')
                .attr('placeholder', 'Hệ thống tự cấp số');
            $('#btnLaySoHopDong').prop('disabled', true).hide();
        }

        // 2. Load dropdown dữ liệu song song
        await tn_LoadTinh();
        await tn_LoadDonVi();
        await tn_LoadQuyTrinh();

        // Sự kiện checkbox "Đơn vị khác"
        $('#tn_chkOtherUnit').off('change').on('change', function () {
            $('#tn_selectDonVi').prop('disabled', !this.checked);
        });

        // Sự kiện đổi tỉnh → load xã
        $('#tn_IDTinh').off('change').on('change', function () {
            tn_LoadXa($(this).val());
        });
        // Sự kiện: Khi người dùng gõ tên xã
        $('#tn_InputXa').off('input change').on('input change', function () {
            const textVal = $(this).val().trim();
            const match = tn_DanhSachXa.find(x => x.tenXa.toLowerCase() === textVal.toLowerCase());

            if (match) {
                $('#tn_IDXa').val(match.id);
            } else {
                $('#tn_IDXa').val('');
            }
        });
    }

    async function tn_LoadQuyTrinh() {
        try {
            const data = await apiGet('/api/admin/QuyTrinh');
            let opts = '<option value="">-- Chọn quy trình --</option>';

            const targetLoai = (typeof SESSION_USER_ID !== 'undefined' && SESSION_USER_ID === -1)
                ? 'DoDacOnline'
                : 'DoDac';

            const filteredData = (data || []).filter(q =>
                q.loaiQuyTrinh && q.loaiQuyTrinh.toLowerCase() === targetLoai.toLowerCase()
            );

            filteredData.forEach(q => {
                opts += `<option value="${q.id}">${q.tenQuyTrinh}</option>`;
            });

            $('#tn_IDQuyTrinh').html(opts);
            if (filteredData.length === 1) {
                $('#tn_IDQuyTrinh').val(filteredData[0].id);
            }

        } catch (e) {
            $('#tn_IDQuyTrinh').html('<option value="">-- Lỗi tải quy trình --</option>');
            console.error("Lỗi tải quy trình:", e);
        }
    }

    // ============================================================
    // LOAD ĐƠN VỊ DỰA VÀO SESSION_TINH_ID CỦA TRANG CHA
    // ============================================================
    async function tn_LoadDonVi() {
        try {
            let url = '/api/dodac/dropdown/all-donvi';

            // Nếu SESSION_TINH_ID hợp lệ (> 0), lọc danh sách đơn vị theo tỉnh
            if (typeof SESSION_TINH_ID !== 'undefined' && SESSION_TINH_ID > 0) {
                url = `/api/dodac/dropdown/donvi-by-tinh/${SESSION_TINH_ID}`;
            }

            const data = await apiGet(url);
            let opts = '<option value="">-- Vui lòng chọn đúng đơn vị xử lý --</option>';

            (data || []).forEach(d => {
                const tenHienThi = d.tenDonVi || d.ten || d.TenDonVi || 'Không rõ tên';
                opts += `<option value="${d.id}">${tenHienThi}</option>`;
            });

            $('#tn_selectDonVi').html(opts);
        } catch (e) {
            $('#tn_selectDonVi').html('<option value="">-- Lỗi tải đơn vị --</option>');
        }
    }

    // ============================================================
    // LOAD TỈNH VÀ TỰ ĐỘNG CHỌN
    // ============================================================
    async function tn_LoadTinh() {
        try {
            const data = await apiGet('/api/dodac/dropdown/all-tinh');
            let opts = '<option value="">-- Chọn Tỉnh --</option>';

            (data || []).forEach(t => {
                opts += `<option value="${t.id}">${t.ten}</option>`;
            });

            $('#tn_IDTinh').html(opts);

            if ($.fn.select2) {
                $('#tn_IDTinh').select2({ theme: 'bootstrap-5', width: '100%' });
            }

            if (typeof SESSION_TINH_ID !== 'undefined' && SESSION_TINH_ID > 0) {
                $('#tn_IDTinh').val(SESSION_TINH_ID);

                if ($.fn.select2) {
                    $('#tn_IDTinh').trigger('change.select2');
                }

                $('#tn_IDTinh').prop('disabled', true);
                await tn_LoadXa(SESSION_TINH_ID);
            }
        } catch (e) {
            $('#tn_IDTinh').html('<option value="">-- Lỗi tải tỉnh --</option>');
        }
    }

    async function tn_LoadXa(idTinh) {
        $('#tn_IDXa').html('<option value="">Đang tải...</option>');

        if (!idTinh) {
            $('#tn_IDXa').html('<option value="">-- Chọn Xã --</option>');
            if ($.fn.select2) $('#tn_IDXa').select2({ theme: 'bootstrap-5', width: '100%' });
            return;
        }

        try {
            const data = await apiGet(`/api/dodac/dropdown/xa-by-tinh/${idTinh}`);
            let opts = '<option value="">-- Chọn Xã --</option>';
            (data || []).forEach(x => {
                opts += `<option value="${x.id}" data-maxa="${x.maXa || ''}">${x.tenXa}</option>`;
            });

            $('#tn_IDXa').html(opts);
            if ($.fn.select2) {
                $('#tn_IDXa').select2({ theme: 'bootstrap-5', width: '100%' });
            }
        } catch (e) {
            $('#tn_IDXa').html('<option value="">-- Lỗi tải xã --</option>');
        }
    }

    async function tn_LaySoHopDong() {
        const idDonVi = $('#tn_selectDonVi').val();
        if (!idDonVi) {
            alert('Chưa xác định được đơn vị để cấp số!');
            return;
        }
        if (!confirm('Hệ thống sẽ cấp số hợp đồng mới. Số sau khi lấy sẽ lưu vào CSDL, không hủy được. Tiếp tục?')) return;

        try {
            const res = await apiGet(`/api/dodac/hosododac/next-sohopdong/${idDonVi}`);
            if (res && res.soHopDong) {
                $('#tn_SoHopDong').val(res.soHopDong).removeClass('is-invalid').addClass('is-valid');
            } else {
                alert('Không lấy được số hợp đồng. Vui lòng thử lại!');
            }
        } catch (e) {
            alert('Lỗi kết nối: ' + e.message);
        }
    }

    async function tn_Submit() {
        const idDonVi = $('#tn_selectDonVi').val();
        const idQuyTrinh = parseInt($('#tn_IDQuyTrinh').val()) || 0;
        const nguoiDangKy = $('#tn_NguoiDangKy').val().trim();
        const soHopDong = $('#tn_SoHopDong').val().trim();

        if (!idDonVi || idDonVi === "") {
            alert('Vui lòng chọn Đơn vị công tác xử lý hồ sơ này!');
            $('#tn_selectDonVi').addClass('is-invalid').focus();
            return;
        }

        if (!idQuyTrinh) { alert('Vui lòng chọn quy trình xử lý!'); return; }
        if (!nguoiDangKy) { alert('Vui lòng nhập tên tổ chức/cá nhân đăng ký!'); return; }

        const dto = {
            idDonViCongTac: parseInt(idDonVi),
            soHopDong: soHopDong,
            idQuyTrinh: idQuyTrinh,
            ngayHopDong: $('#tn_NgayHopDong').val(),
            nguoiDangKy: nguoiDangKy,
            cccd: $('#tn_CCCD').val(),
            soDienThoai: $('#tn_SoDienThoai').val(),
            mucDichDangKy: $('#tn_MucDich').val(),
            diaChiThuaDat: $('#tn_DiaChiThuaDat').val(),
            seriGcn: $('#tn_SeriGCN').val(),
            idXa: parseInt($('#tn_IDXa').val()) || null,
            idTinh: parseInt($('#tn_IDTinh').val()) || null,
            ghiChu: $('#tn_GhiChu').val(),
            chkOtherUnit: true
        };

        try {
            const res = await apiPost('/api/dodac/hosododac', dto);
            if (res && res.success) {
                alert('Tiếp nhận hồ sơ thành công! Mã hồ sơ: ' + res.id);
                if (typeof CURRENT_USER_ROLE !== 'undefined' && CURRENT_USER_ROLE === 'Khách') {
                    loadTask('HoSoKhach', null);
                } else {
                    loadTask('XuLy', null);
                    await renderDanhSachHoSo(true);
                }
            } else {
                alert('Lỗi lưu hồ sơ: ' + (res?.message || 'Không xác định'));
            }
        } catch (e) {
            alert('Lỗi kết nối: ' + e.message);
        }
    }

    function tn_Cancel() {
        if (typeof SESSION_USER_ID !== 'undefined' && SESSION_USER_ID === -1) {
            loadTask('HoSoKhach', null);
        } else {
            loadTask('XuLy', null);
        }
    }
    function tn_ApplyStyles() {
        $('.form-control, .form-select').each(function () {
            var el = $(this);
            var val = el.val();

            if (val && val.toString().trim() !== '' && val !== '0') {
                el.addClass('is-filled');
            } else {
                el.removeClass('is-filled');
            }
        });
    }
    $(document).on('input change', '.form-control, .form-select', function () {
        tn_ApplyStyles();
    });
    $(document).ready(function () {
        setTimeout(tn_ApplyStyles, 500);
    });
</script>